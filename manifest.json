{
  "manifest_version": 3,
  "name": "Za Hando Eraser",
  "version": "1.1",
  "description": "ZA HANDO",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sfx1.mp3", "sfx2.mp3", "sfx3.mp3"],
      "matches": ["<all_urls>"]
    }
  ]
}
